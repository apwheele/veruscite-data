  year = {2026},
  issn = {3050-4759},
  doi = {10.1016/j.nexres.2025.101303},
  url = {https://www.sciencedirect.com/science/article/pii/S3050475925011686},
  abstract = {This article has been retracted: please see Elsevier policy on article withdrawal (https://www.elsevier.com/about/policies-and-standards/article-withdrawal). This article has been retracted at the request of the Editor. Following concerns regarding the reliability of the citations included in this article, the journal conducted an investigation and requested clarification from the author. Although a revised version of the manuscript was submitted with changes to the reference list, the review identified substantial irregularities in the cited literature. A large number of references were replaced, and several citations contained incorrect or non-traceable DOI/ISBN identifiers. In addition, multiple references contained discrepancies such as identifiers corresponding to unrelated publications or author information mismatches. Given the extent of these issues, the Editor has lost confidence in the reliability of the references supporting the article and therefore in the scientific integrity of the work. The journal apologises to readers that these issues were not detected during the submission process.}
}

